
pipeline {
    agent any

    environment {
        SONARQUBE = 'SonarQube'
    }

    stages {
        stage('Git Checkout') {
            steps {
                git branch: 'main', changelog: false, poll: false, url: 'https://github.com/Dilinaraveen/healthcare-platform-management-system.git'
            }
        }

        stage('Install & Build (client only)') {
            steps {
                dir('client') {
                    bat 'npm install'
                    bat 'npm run build'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('client') {
                    withSonarQubeEnv("${SONARQUBE}") {
                        withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
                            bat "sonar-scanner -Dsonar.login=%SONAR_TOKEN%"
                        }
                    }
                }
            }
        }
        stage('Build and Push Docker Image') {
            steps {
                dir('client') {
                    withDockerRegistry(credentialsId: 'docker-hub', toolName: 'Default') {
                        bat 'docker build -t healthcare-client:latest .'
                        bat 'docker tag healthcare-client:latest dilina/healthcare-client:latest'
                        bat 'docker push dilina/healthcare-client:latest'
                    }
                }
            }
        }

    }
}

