pipeline {
    agent any

    environment {
        IMAGE_NAME = "yourdockerhub/healthcare-client"
        EC2_HOST = "ec2-user@<EC2-PUBLIC-IP>"
    }

    stages {
        stage('Deploy to EC2') {
            steps {
                sshagent(['ec2-key']) {
                    sh """
                        ssh $EC2_HOST "
                            docker pull $IMAGE_NAME &&
                            docker stop client-app || true &&
                            docker rm client-app || true &&
                            docker run -d --name client-app -p 80:80 $IMAGE_NAME
                        "
                    """
                }
            }
        }
    }
}
